{
    "image_gen_key": {
        "type": "string",
        "default": "",
        "description": "生图 Token",
        "hint": "必填。在 nai.sta1n.cn 申请到的 toUserId。",
        "obvious": true
    },
    "base_url": {
        "type": "string",
        "default": "https://nai.sta1n.cn",
        "description": "生图服务地址"
    },
    "image_style": {
        "type": "string",
        "default": "vertical",
        "description": "默认风格",
        "options": [
            "vertical",
            "comicDoujin",
            "r18",
            "lolita25d",
            "anime",
            "galgame",
            "自定义"
        ],
        "hint": "选「自定义」时使用下方「自定义画师串」，其余风格使用内置画师串。旧配置里的 custom 与「自定义」等价。"
    },
    "image_size": {
        "type": "string",
        "default": "竖图",
        "description": "默认尺寸",
        "hint": "选择生成图片的尺寸和分辨率；选项中的数字表示相对成本，2K 和 4K 会产生更高成本。",
        "options": [
            "竖图",
            "横图",
            "方图",
            "2K竖图",
            "2K横图",
            "2K方图",
            "4K竖图",
            "4K横图",
            "4K方图"
        ]
    },
    "image_count": {
        "type": "int",
        "default": 2,
        "description": "默认生成数量",
        "hint": "每次生成 1-6 张图片。",
        "min": 1,
        "max": 6
    },
    "bot_reply_mode": {
        "type": "string",
        "default": "完整",
        "description": "Bot 回复模式",
        "hint": "「仅图片」只在成功后发送图片，失败报错不受影响；「简洁」只发送正在画图和简要参数；「完整」保留提示词及参数回复。",
        "options": [
            "仅图片",
            "简洁",
            "完整"
        ]
    },
    "save_image_history": {
        "type": "bool",
        "default": false,
        "description": "保存生图历史",
        "hint": "开启后将所有成功生成的图片保存到 plugin_data/astrbot_plugin_nai_image/image_history。"
    },
    "image_history_limit": {
        "type": "int",
        "default": 0,
        "description": "历史保留数量",
        "hint": "仅在保存生图历史时生效。每次保存后自动删除最旧图片，仅保留指定数量；设为 0 不清理。",
        "min": 0
    },
    "custom_artists": {
        "type": "string",
        "default": "",
        "description": "自定义画师串",
        "hint": "仅在「默认风格」选择「自定义」时生效。"
    },
    "enable_template": {
        "type": "bool",
        "default": true,
        "description": "启用提示词模板",
        "hint": "开启后将「角色核心关键词与身体描述补全」拼接到提示词最前面；关闭后只发送原始提示词。"
    },
    "character_preset": {
        "type": "string",
        "default": "",
        "description": "角色预设",
        "hint": "填入角色在 NAI 里的核心关键词和身体描述补全，如 muelsyse(Arknights), mechanical headwear 等。无论是否开启 LLM 转译，本项都会拼接（这是关闭转译后唯一保留的提示词预处理）。若源请求插件已带角色词则无需配置。"
    },
    "default_outfit": {
        "type": "string",
        "default": "",
        "description": "默认服装",
        "hint": "仅在开启 LLM 转译时生效；提示词没有具体服装且缓存为空时自动补全。使用英文逗号分隔 SD/NAI tag，例如：modern fashion, dark green knit dress, fitted sweater, slim pants, leather boots。"
    },
    "outfit_cache_ttl_seconds": {
        "type": "int",
        "default": 3600,
        "description": "服装缓存时长",
        "hint": "单位为秒，仅在开启 LLM 转译时生效。具体服装或换装描述会写入缓存，后续模糊描述自动沿用；默认 3600 秒，超时后回退默认服装，设为 0 可关闭缓存。",
        "min": 0,
        "max": 86400
    },
    "model": {
        "type": "string",
        "default": "nai-diffusion-4-5-full",
        "description": "生图模型"
    },
    "steps": {
        "type": "int",
        "default": 24,
        "description": "采样步数"
    },
    "scale": {
        "type": "int",
        "default": 6,
        "description": "scale"
    },
    "cfg": {
        "type": "float",
        "default": 0.0,
        "description": "CFG Rescale",
        "hint": "对应接口参数 cfg，范围 0-30，支持小数和 0 值。",
        "min": 0,
        "max": 30
    },
    "sampler": {
        "type": "string",
        "default": "k_dpmpp_2m_sde",
        "description": "采样器",
        "options": [
            "k_dpmpp_2m_sde",
            "k_dpmpp_2m",
            "k_dpmpp_sde",
            "k_dpmpp_2s_ancestral",
            "k_euler_ancestral",
            "k_euler"
        ]
    },
    "noise_schedule": {
        "type": "string",
        "default": "karras",
        "description": "噪声调度"
    },
    "negative": {
        "type": "string",
        "default": "",
        "description": "反向提示词",
        "hint": "留空时使用插件内置的默认反向提示词。"
    },
    "proxy_port": {
        "type": "int",
        "default": 8765,
        "description": "本地代理端口",
        "hint": "陪伴插件通过此端口调用生图；修改后需要重载插件。",
        "min": 1024,
        "max": 65535
    },
    "enable_translate": {
        "type": "bool",
        "default": false,
        "description": "启用提示词转译",
        "hint": "建议使用小模型。开启后将自然语言转为 SD/NAI 标签，自动剥离 <think> 思考块，并启用服装缓存和默认服装补全；失败时回退原文。关闭后仅保留角色预设拼接，提示词按 NAI 标签原样发送。"
    },
    "translate_provider": {
        "type": "string",
        "default": "",
        "description": "转译模型供应商",
        "hint": "从 AstrBot 已配置的 provider 中选一个。留空时使用 AstrBot 的默认 provider。建议选择便宜/快速的小模型。",
        "_special": "select_provider"
    },
    "enable_llm_tool": {
        "type": "bool",
        "default": false,
        "description": "启用 LLM 生图工具",
        "hint": "关闭后 LLM agent 无法调用此工具；开启后允许 LLM 自主决定生图时机（每次限 1 张）。"
    }
}
